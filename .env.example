# Copy to .env: cp .env.example .env

# ── Admin credentials ─────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
# Set a strong password. If left unset in local dev, a random one is generated
# on first start and printed once in the server logs.
ADMIN_PASSWORD=

# ── Security (required) ───────────────────────────────────────────────────────
# Min 32 characters. The app refuses to start without this.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# ── User registration ─────────────────────────────────────────────────────────
# Only emails ending in this domain can register (e.g. mycompany.com).
# Leave empty to disable self-registration entirely.
ALLOWED_DOMAIN=

# ── Join links / QR codes (optional) ──────────────────────────────────────────
# URL phones use to reach this app, e.g. https://quiz.example.com or
# http://192.168.1.20:3000. Empty = the host browser's address, which fails for
# phones when the host is on localhost. Also editable in Settings.
PUBLIC_URL=

# ── Media search in Quiz Studio (optional) ────────────────────────────────────
# API keys stay server-side. Openverse works without keys; missing keys hide
# that provider's tab in the media picker.
UNSPLASH_ACCESS_KEY=
GIPHY_API_KEY=

# ── Docker networking (optional) ──────────────────────────────────────────────
# Host port for the app. Change it if 3000 is taken.
# APP_PORT=3000
# Set to 127.0.0.1 so the app is reachable only through a reverse proxy.
# APP_BIND=0.0.0.0

# ── Built-in HTTPS with Caddy (optional) ──────────────────────────────────────
# Only for a server dedicated to Quizz: docker compose --profile caddy up -d
# Point this domain's DNS at the server first. Also set PUBLIC_URL=https://<domain>.
# DOMAIN=quiz.example.com
